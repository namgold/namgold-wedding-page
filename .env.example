# Cloudflare Tunnel (a separate tunnel just for linhhy.namgold.com)
# Get this from: Cloudflare Zero Trust > Networks > Tunnels > wedding > Configure > Docker
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# --- Optional. Leave blank to keep a feature off. ---

# Cloudflare Turnstile (spam protection on the public forms). Blank = honeypot + rate limit only.
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Telegram notifications: one bot and one chat per kind (wishes, RSVPs). The chats may be
# the same or different. A blank token or chat id turns that kind off.
# A group chat id is negative (e.g. -123456789); the bot must be in that chat.
TELEGRAM_WISH_BOT_TOKEN=
TELEGRAM_WISH_CHAT_ID=
TELEGRAM_RSVP_BOT_TOKEN=
TELEGRAM_RSVP_CHAT_ID=

# Admin page (/admin, /api/admin/*). Blank = the admin API answers 503 (fails closed).
# Team domain: Zero Trust > Settings > Custom pages / "Team domain", e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag of the self-hosted Access app protecting /admin* and /api/admin*
CF_ACCESS_AUD=
# Optional extra allow-list (comma separated) on top of the Access policy. Do not commit real emails.
ADMIN_EMAILS=
